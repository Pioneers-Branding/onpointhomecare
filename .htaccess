RewriteEngine On

# Serve the sitemap dynamically so scheduled blog posts appear on their own publish date
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Redirect external .php requests to extensionless URL (prevent duplicate content)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Resolve .php file for extensionless URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*?)/?$ $1.php [L]
